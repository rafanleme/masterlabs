# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=masterlabs_db
MYSQL_USER=root
MYSQL_PASSWORD=your-password

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Prisma / Database URL
DATABASE_URL="mysql://user:password@host:3306/database"

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Storage API (PDFs de laudos)
STORAGE_BASE_URL=https://www.rtisolutionscode.com.br/storage
STORAGE_API_KEY=change-me
STORAGE_TIMEOUT_MS=30000
STORAGE_MAX_BYTES=10485760

# CORS — origens permitidas separadas por vírgula (vazio libera todas)
CORS_ORIGINS=

# Rate limiting (default: habilitado apenas em produção)
RATE_LIMIT_ENABLED=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# SMTP — e-mails transacionais (portal do cliente). Sem SMTP_HOST, códigos são apenas logados.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MasterLabs <no-reply@masterlabs.com.br>"

# Portal do cliente (magic code)
PORTAL_CODE_TTL_MINUTES=15
PORTAL_MAX_VERIFY_ATTEMPTS=5
PORTAL_MAX_CODES_PER_HOUR=3
PORTAL_JWT_EXPIRES_IN=1h
