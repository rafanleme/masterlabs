# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=masterlabs_db
MYSQL_USER=root
MYSQL_PASSWORD=your-password

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Prisma / Database URL
DATABASE_URL="mysql://user:password@host:3306/database"

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Storage API (PDFs de laudos)
STORAGE_BASE_URL=https://www.rtisolutionscode.com.br/storage
STORAGE_API_KEY=change-me
STORAGE_TIMEOUT_MS=30000
STORAGE_MAX_BYTES=10485760
